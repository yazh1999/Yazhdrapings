# Copy to .env.local and fill in. Never commit .env.local.
# Vercel: set the same keys for Production, Preview and Development.
# See docs/06-production.md section 2.

NEXT_PUBLIC_SITE_URL=https://yazhdrapings.com
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/yazhdrapings

# Leave unset in Development and Preview so test traffic stays out of analytics.
NEXT_PUBLIC_GA_ID=

# Server-only. Must NOT be prefixed NEXT_PUBLIC_ — that would ship it to the browser.
RESEND_API_KEY=
RESEND_FROM=bookings@yazhdrapings.com
BOOKING_INBOX=orders@yazhdrapings.com

NEXT_PUBLIC_MAPS_EMBED_URL=
